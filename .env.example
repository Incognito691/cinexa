# TMDB — movie and TV metadata (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# NextAuth — session signing secret
NEXTAUTH_SECRET=

# Database — PostgreSQL (via Prisma)
DATABASE_URL=

# Google OAuth — sign-in with Google (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — OpenAI (reserved for future features)
OPENAI_API_KEY=
# Public site origin — canonical URLs + Open Graph images
# Must be set in production or share links point at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
